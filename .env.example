# Smart Climate Guardian - Environment Variables Template
# Copy to .env for local development or configure in your Vercel Dashboard

# Client-Side Public Keys (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Secrets (Vercel Serverless Functions - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
FIRMS_MAP_KEY=your-nasa-firms-map-key
CRON_SECRET=your-random-cron-secret-key
